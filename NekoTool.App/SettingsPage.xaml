<UserControl
    x:Class="NekoTool.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28"
                    Spacing="18"
                    MaxWidth="860"
                    HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="设置"
                           Style="{StaticResource NekoSectionTitleStyle}" />
                <TextBlock Text="控制 NekoTool 的启动行为与本地服务端口"
                           Style="{StaticResource NekoMutedTextStyle}" />
            </StackPanel>

            <InfoBar x:Name="SettingsBar"
                     IsOpen="False"
                     IsClosable="True" />

            <!-- Startup behavior -->
            <Border Style="{StaticResource NekoCardStyle}"
                    Padding="20,18">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="开机自启"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NekoTextPrimaryBrush}" />
                            <TextBlock Text="登录 Windows 后自动启动 NekoTool 桌面外壳"
                                       Style="{StaticResource NekoMutedTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle"
                                      Grid.Column="1"
                                      IsOn="False"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="44"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1"
                            Background="{StaticResource NekoDividerBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="静默运行"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NekoTextPrimaryBrush}" />
                            <TextBlock Text="关闭窗口后继续保留 Python Dashboard 与 StatusCast"
                                       Style="{StaticResource NekoMutedTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SilentToggle"
                                      Grid.Column="1"
                                      IsOn="True"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="44"
                                      VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Local service -->
            <Border Style="{StaticResource NekoCardStyle}"
                    Padding="20,18">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="本地端口"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NekoTextPrimaryBrush}" />
                        <TextBlock Text="NekoTool 桌面外壳访问 Python Dashboard 时使用的端口，修改后需要重启后端。"
                                   Style="{StaticResource NekoMutedTextStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PortBox"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 PlaceholderText="5100"
                                 InputScope="Number" />
                        <TextBlock Grid.Column="1"
                                   Text="默认 5100"
                                   Style="{StaticResource NekoMutedTextStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,2,0,0">
                <Button x:Name="SaveButton"
                        Content="保存设置"
                        Style="{StaticResource NekoAccentButtonStyle}"
                        Click="SaveButton_Click" />
                <TextBlock Text="原型阶段：只更新本次运行的界面状态，不写入注册表。"
                           Style="{StaticResource NekoMutedTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
