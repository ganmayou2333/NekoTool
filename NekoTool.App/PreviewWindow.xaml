<Window
    x:Class="NekoTool.App.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OBS 挂件预览">

    <Grid x:Name="RootGrid"
          Background="#FF0B0D11"
          RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Preview toolbar -->
        <Grid Grid.Row="0"
              Background="#FF14171C"
              BorderBrush="#18FFFFFF"
              BorderThickness="0,0,0,1"
              Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE714;"
                          FontSize="13"
                          Foreground="{StaticResource NekoGreenBrush}" />
                <TextBlock Text="OBS 挂件预览"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NekoTextPrimaryBrush}" />
                <TextBlock Text="独立 WebView2 窗口"
                           FontSize="10"
                           Foreground="{StaticResource NekoTextMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button x:Name="ReloadButton"
                        Style="{StaticResource NekoIconButtonStyle}"
                        Click="ReloadButton_Click"
                        ToolTipService.ToolTip="重新加载">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="OpenExternalButton"
                        Style="{StaticResource NekoIconButtonStyle}"
                        Click="OpenExternalButton_Click"
                        ToolTipService.ToolTip="在默认浏览器中打开">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- WebView2 is scoped to this window only. The main shell stays 100% native. -->
        <Grid x:Name="PreviewHost"
              Grid.Row="1">
            <WebView2 x:Name="PreviewView" />

            <Grid x:Name="LoadingOverlay"
                  Background="#F20B0D11">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing x:Name="LoadingRing"
                                  Width="34"
                                  Height="34"
                                  IsActive="True" />
                    <TextBlock Text="正在加载挂件预览…"
                               FontSize="12"
                               Foreground="{StaticResource NekoTextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ErrorOverlay"
                  Background="#F20B0D11"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="520"
                            Margin="24">
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="30"
                              Foreground="#FFE07A7A" />
                    <TextBlock x:Name="ErrorMessage"
                               FontSize="13"
                               Foreground="{StaticResource NekoTextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Content="重试"
                            Style="{StaticResource NekoSecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="RetryButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The full URL is useful when debugging an OBS source. -->
        <Grid Grid.Row="2"
              Background="#FF0F1115"
              Padding="14,0">
            <TextBlock x:Name="UrlText"
                       FontSize="9"
                       FontFamily="Cascadia Mono, Consolas"
                       Foreground="{StaticResource NekoTextMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
