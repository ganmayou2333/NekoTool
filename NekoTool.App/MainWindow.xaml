<Window
    x:Class="NekoTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NekoTool.App"
    xmlns:models="using:NekoTool.App.Models"
    Title="NekoTool">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          RequestedTheme="Dark">

        <Grid.Resources>
            <!-- Keep ListView chrome out of the way: the card itself is the surface. -->
            <Style x:Key="PluginListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =========================================================
             Custom title bar, drawn by the app so Mica reaches the top.
             ========================================================= -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Border Width="24"
                        Height="24"
                        CornerRadius="7"
                        Background="{StaticResource NekoGreenBrush}">
                    <FontIcon Glyph="&#xE8B7;"
                              FontSize="13"
                              Foreground="#FF101408" />
                </Border>
                <TextBlock Text="NekoTool"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NekoTextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Border Background="#16FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="WINUI 3"
                               FontSize="9"
                               FontWeight="SemiBold"
                               CharacterSpacing="80"
                               Foreground="{StaticResource NekoTextMutedBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- =========================================================
             Main shell
             ========================================================= -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        CompactPaneLength="48"
                        IsPaneOpen="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneHeader>
                <TextBlock Text="工作台"
                           Margin="16,10,0,8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           CharacterSpacing="120"
                           Foreground="{StaticResource NekoTextMutedBrush}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="PluginsNavItem"
                                    Content="插件管理"
                                    Tag="plugins"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem"
                                    Content="设置"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <!-- =================================================
                     VIEW 1 · PLUGINS
                     ================================================= -->
                <Grid x:Name="PluginsPage"
                      Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page heading -->
                    <Grid Grid.Row="0" Margin="28,20,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="插件管理"
                                       Style="{StaticResource NekoSectionTitleStyle}" />
                            <TextBlock Text="Steam 状态预览、OBS 挂件与本地 PowerShell 插件"
                                       Style="{StaticResource NekoMutedTextStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource NekoChipStyle}"
                                VerticalAlignment="Center">
                            <TextBlock Text="纯原生 · 无 WebView 嵌套"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NekoGreenBrush}" />
                        </Border>
                    </Grid>

                    <!-- =============================================
                         Steam presence card
                         ============================================= -->
                    <Border Grid.Row="1"
                            Margin="28,18,28,0"
                            Padding="18"
                            Style="{StaticResource NekoCardStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar. The glyph stays visible as an offline fallback. -->
                            <Border Width="76"
                                    Height="76"
                                    CornerRadius="12"
                                    Background="#2A90BA3C"
                                    BorderBrush="#3A90BA3C"
                                    BorderThickness="1">
                                <Grid>
                                    <FontIcon Glyph="&#xE77B;"
                                              FontSize="30"
                                              Foreground="{StaticResource NekoGreenBrush}" />
                                    <Image Source="{x:Bind ViewModel.AvatarSource, Mode=OneWay}"
                                           Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SteamName, Mode=OneWay}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource NekoChipStyle}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="STEAM"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="90"
                                                   Foreground="{StaticResource NekoGreenBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="NekoTool"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NekoGreenBrush}" />

                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{StaticResource NekoTextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Spacing="7"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource NekoAccentButtonStyle}"
                                        Click="CopyCommand_Click"
                                        ToolTipService.ToolTip="复制 PowerShell 启动命令">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        <TextBlock Text="复制启动命令" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.SteamIdDisplay, Mode=OneWay}"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource NekoTextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- =============================================
                         OBS widget settings
                         ============================================= -->
                    <Expander x:Name="ObsExpander"
                              Grid.Row="2"
                              Margin="28,12,28,0"
                              Background="{StaticResource NekoCardBackgroundBrush}"
                              BorderBrush="{StaticResource NekoCardBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="12"
                              HorizontalContentAlignment="Stretch"
                              IsExpanded="True">
                        <Expander.Header>
                            <Grid Margin="4,2,4,2"
                                  ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE714;"
                                                  FontSize="14"
                                                  Foreground="{StaticResource NekoGreenBrush}" />
                                        <TextBlock Text="OBS 挂件"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource NekoTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="生成浏览器源链接，或在独立窗口中预览"
                                               Style="{StaticResource NekoMutedTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="Browser Source"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource NekoTextMutedBrush}" />
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="16,6,16,16"
                                    Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="主题"
                                               FontSize="13"
                                               Foreground="{StaticResource NekoTextPrimaryBrush}" />
                                    <TextBlock Text="控制 OBS 挂件在直播画面中的配色"
                                               Style="{StaticResource NekoMutedTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="1"
                                          SelectedIndex="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="赛博朋克" Tag="cyberpunk" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="透明背景"
                                               FontSize="13"
                                               Foreground="{StaticResource NekoTextPrimaryBrush}" />
                                    <TextBlock Text="叠加到 OBS 时去掉挂件底色"
                                               Style="{StaticResource NekoMutedTextStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="TransparentToggle"
                                              Grid.Column="1"
                                              IsOn="True"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="44"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="链接由本地 widget.html 生成，可随时重新复制。"
                                           Style="{StaticResource NekoMutedTextStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Style="{StaticResource NekoSecondaryButtonStyle}"
                                            Click="GenerateObsLink_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE71B;" FontSize="13" />
                                            <TextBlock Text="生成 OBS 链接" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource NekoSecondaryButtonStyle}"
                                            Click="PreviewObs_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                                            <TextBlock Text="预览挂件" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- =============================================
                         Plugin list + right-hand native editor.
                         SplitView keeps both states in one page:
                         no navigation, no WebView flash.
                         ============================================= -->
                    <SplitView x:Name="EditorSplitView"
                               Grid.Row="3"
                               Margin="28,18,28,24"
                               PanePlacement="Right"
                               DisplayMode="Overlay"
                               OpenPaneLength="480"
                               IsPaneOpen="False"
                               PaneBackground="Transparent"
                               Background="Transparent"
                               PaneClosed="EditorSplitView_PaneClosed">
                        <SplitView.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="已安装插件"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource NekoTextPrimaryBrush}" />
                                        <TextBlock Text="每个插件是一个独立的 PowerShell 脚本；当前为原型数据。"
                                                   Style="{StaticResource NekoMutedTextStyle}" />
                                    </StackPanel>
                                </Grid>

                                <ListView x:Name="PluginListView"
                                          Grid.Row="1"
                                          ItemsSource="{x:Bind Plugins}"
                                          ItemContainerStyle="{StaticResource PluginListItemStyle}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="False"
                                          Padding="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PluginItem">
                                            <Border Style="{StaticResource NekoCardStyle}"
                                                    Padding="16,13">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Drag handle. Actual reorder can be wired later. -->
                                                    <FontIcon Grid.Column="0"
                                                              Glyph="&#xE700;"
                                                              FontSize="14"
                                                              Foreground="{StaticResource NekoTextMutedBrush}"
                                                              VerticalAlignment="Center"
                                                              ToolTipService.ToolTip="拖动排序" />

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <TextBlock Text="{x:Bind Title}"
                                                                       Style="{StaticResource NekoCardTitleStyle}" />
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource NekoTextMutedBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Description}"
                                                                   Style="{StaticResource NekoMutedTextStyle}"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                      OnContent=""
                                                                      OffContent=""
                                                                      MinWidth="44"
                                                                      Toggled="PluginToggle_Toggled"
                                                                      AutomationProperties.Name="启用或停用插件" />
                                                        <Button Style="{StaticResource NekoIconButtonStyle}"
                                                                Tag="{x:Bind Name}"
                                                                Click="EditPlugin_Click"
                                                                ToolTipService.ToolTip="编辑">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                                        </Button>
                                                        <Button Style="{StaticResource NekoIconButtonStyle}"
                                                                Tag="{x:Bind Name}"
                                                                Click="DeletePlugin_Click"
                                                                ToolTipService.ToolTip="删除">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </SplitView.Content>

                        <SplitView.Pane>
                            <Border Margin="18,0,0,0"
                                    Padding="20"
                                    Style="{StaticResource NekoCardStyle}"
                                    Background="{StaticResource NekoCardElevatedBrush}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="EditorTitle"
                                                       Text="编辑插件"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource NekoTextPrimaryBrush}" />
                                            <TextBlock x:Name="EditorFileName"
                                                       Text="未选择插件"
                                                       FontSize="11"
                                                       Foreground="{StaticResource NekoGreenBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource NekoIconButtonStyle}"
                                                Click="CloseEditor_Click"
                                                ToolTipService.ToolTip="关闭编辑器">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="原生 TextBox · 等宽字体"
                                               Style="{StaticResource NekoMutedTextStyle}" />

                                    <TextBox x:Name="PluginEditor"
                                             Grid.Row="2"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             IsSpellCheckEnabled="False"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="12.5"
                                             Padding="12"
                                             CornerRadius="10"
                                             Background="{StaticResource NekoInputBackgroundBrush}"
                                             BorderBrush="{StaticResource NekoCardBorderBrush}"
                                             BorderThickness="1"
                                             VerticalAlignment="Stretch"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="# 在这里编写 PowerShell 插件..." />

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模拟模式 · 保存只更新当前会话"
                                                   Style="{StaticResource NekoMutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource NekoAccentButtonStyle}"
                                                Click="SavePlugin_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                                <TextBlock Text="保存" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </SplitView.Pane>
                    </SplitView>
                </Grid>

                <!-- =================================================
                     VIEW 2 · SETTINGS
                     ================================================= -->
                <local:SettingsPage x:Name="SettingsView"
                                    Visibility="Collapsed" />

                <!-- Transient feedback, above both views. -->
                <InfoBar x:Name="ToastBar"
                         MaxWidth="420"
                         Margin="0,14,28,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         IsOpen="False"
                         IsClosable="True" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
